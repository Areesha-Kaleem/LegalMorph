# Azure OpenAI API Configuration
AZURE_OPENAI_API_KEY=your_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-11-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=lawgpt_metadata

# Token limits configuration for different transformation phases
TRANSFORM_MAX_TOKENS_CASES_BASE=8192
TRANSFORM_MAX_TOKENS_CASES_CUSTOM=8192
TRANSFORM_MAX_TOKENS_CASES_MERGE=8192
TRANSFORM_MAX_TOKENS_STATUTES_BASE=8192
TRANSFORM_MAX_TOKENS_STATUTES_CUSTOM=8192
TRANSFORM_MAX_TOKENS_STATUTES_MERGE=8192